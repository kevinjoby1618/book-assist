# Public Supabase project URL (from Supabase Project Settings → API)
VITE_SUPABASE_URL=

# Public/publishable Supabase key (sb_publishable_...); never use a secret/service-role key here
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side aliases used by the SSR client. Use the same project URL/key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
